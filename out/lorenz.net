				(source "lorenz.kicad_sch")
				(comment
					(number "1")
					(value "dx/dt = s(y-x)   dy/dt = rx - y - xz   dz/dt = xy - bz")
				)
				(comment
					(number "2")
					(value "s = 10,  r = 28,  b = 8/3")
				)
				(comment
					(number "3")
					(value "Every coefficient is 1 MEG / R;  signals are 0.1 V per unit")
				)
				(comment
					(number "4")
					(value "Open source -- https://github.com/gallicchio/ai_unleashes_chaos")
